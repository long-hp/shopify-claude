{%- comment -%} Static button + critical CSS for <xo-theme-settings> (lazy loader adopts this node). Keep in sync with assets/theme-settings.ts. {%- endcomment -%}
<style>xo-theme-settings{display:contents}xo-theme-settings .xo-ts-fab.xo-ts-fab{all:unset;box-sizing:border-box;position:fixed;z-index:var(--xo-ts-z,2147483000);display:inline-flex;align-items:center;gap:8px;padding:11px 16px 11px 13px;border-radius:999px;background:var(--xo-ts-accent,#161616);color:var(--xo-ts-accent-fg,#fff);font:600 14px/1.2 var(--xo-ts-font,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif);letter-spacing:normal;text-transform:none;white-space:nowrap;box-shadow:0 8px 28px rgba(0,0,0,.22);cursor:pointer}xo-theme-settings .xo-ts-fab.xo-ts-fab svg{display:block;flex:none;width:18px;height:18px;fill:none;stroke:currentColor}xo-theme-settings .xo-ts-fab.xo-ts-fab>span{all:unset}xo-theme-settings .xo-ts-fab[data-pos$=right]{right:max(16px,env(safe-area-inset-right))}xo-theme-settings .xo-ts-fab[data-pos$=left]{left:max(16px,env(safe-area-inset-left))}xo-theme-settings .xo-ts-fab[data-pos^=bottom]{bottom:max(16px,env(safe-area-inset-bottom))}xo-theme-settings .xo-ts-fab[data-pos^=top]{top:16px}xo-theme-settings .xo-ts-fab[data-pos^=middle]{top:50%;transform:translateY(-50%)}xo-theme-settings .xo-ts-fab[aria-busy=true] svg{animation:xo-ts-rot .8s linear infinite}@keyframes xo-ts-rot{to{transform:rotate(1turn)}}</style>
<button type="button" class="xo-ts-fab" data-pos="{{ xo_ts_position }}" aria-haspopup="dialog" aria-expanded="false" aria-label="{{ xo_ts_label | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg><span>{{ xo_ts_label | escape }}</span></button>
